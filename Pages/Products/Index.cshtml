@page
@model wt_lab8_8razor_postgresql_makarevich.Pages.Products.IndexModel
@{
    ViewData["Title"] = "Товары";
}

<h1>Список товаров</h1>

<form method="get" class="mb-3 d-flex gap-2">
    <input type="text" name="Search" value="@Model.Search" class="form-control w-25" placeholder="Поиск по названию...">
    <button type="submit" class="btn btn-primary">Найти</button>
    <a asp-page="./Index" class="btn btn-outline-secondary">Сбросить</a>
</form>

<a asp-page="./Create" class="btn btn-success mb-3">Добавить новый товар</a>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Название</th>
            <th>Категория</th>
            <th>Цена (BYN)</th>
            <th>Доступен</th>
            <th>Описание</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Products.Count == 0)
        {
            <tr>
                <td colspan="7" class="text-center">Товаров пока нет. Добавьте первый товар!</td>
            </tr>
        }
        else
        {
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Id</td>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price</td>
                    <td>@(product.IsAvailable ? "Да" : "Нет")</td>
                    <td>@(string.IsNullOrEmpty(product.Description) ? "—" : product.Description)</td>
                    <td>
                        <a asp-page="./Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Изменить</a>
                        <a asp-page="./Delete" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Удалить</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>